{
  "name": "alpine-components-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "test": "pnpm exec vitest",
    "test:unit": "pnpm exec vitest run",
    "test:browser": "pnpm exec playwright test",
    "test:build": "pnpm exec vitest run tests/build",
    "test:all": "npx pnpm run test:unit && npx pnpm run test:build && npx pnpm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitest/browser": "^4.1.4",
    "happy-dom": "^20.9.0",
    "jsdom": "^27.4.0",
    "playwright": "^1.59.1",
    "vite": "^6.4.1",
    "vitest": "^4.1.4"
  }
}
