{
  "name": "alpine-components",
  "version": "1.0.0",
  "description": "Lazy-loaded components with slots for Alpine.js",
  "type": "module",
  "main": "dist/module.cjs.js",
  "module": "dist/module.esm.js",
  "unpkg": "dist/cdn.min.js",
  "jsdelivr": "dist/cdn.min.js",
  "exports": {
    ".": {
      "import": "./dist/module.esm.js",
      "require": "./dist/module.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c"
  },
  "keywords": [
    "alpine",
    "alpinejs",
    "components",
    "lazy-loading"
  ],
  "author": "Reece Holmdahl",
  "license": "MIT",
  "peerDependencies": {
    "alpinejs": "^3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.56.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reecelikesramen/alpine-components.git",
    "directory": "packages/alpine-components"
  }
}
